DB_NAME=sport
DB_USER=sport
DB_PASSWORD=sport_local
DEMO_ENABLED=true
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
BACKEND_BIND=127.0.0.1
# Geoapify: подсказки адресов и адрес по точке. Ключ хранится только на сервере.
# https://myprojects.geoapify.com/ -> проект -> API Keys
GEOAPIFY_API_KEY=
# Existing databases: set their actual DB_NAME/DB_USER/DB_PASSWORD and volume name.
# POSTGRES_VOLUME=existing_postgres_data
